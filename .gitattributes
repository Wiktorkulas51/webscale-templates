# One line ending for every tool and editor; stops whole-file diffs on Windows.
* text=auto eol=lf

# cmd.exe needs CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.pdf binary
*.zip binary
